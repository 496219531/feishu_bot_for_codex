FEISHU_APP_ID=cli_xxxxx
FEISHU_APP_SECRET=***

# 可选: 飞书事件订阅里的 Verification Token
FEISHU_VERIFICATION_TOKEN=***

# 官方 SDK 长连接模式：不需要公网回调 / tunnel
FEISHU_CONNECTION_MODE=long

# 强烈建议只允许你自己的 open_id
ALLOWED_OPEN_IDS=

# 新机器人独立端口，避免和现有 openclaw bot 共用
PORT=8788

# Hermes 工作目录
WORKSPACE_DIR=/Users/hkk/Documents/feishu_bot_for_codex

# 可选: 指定 Hermes 可执行文件路径
HERMES_BIN=hermes
NODE_BIN=/Users/hkk/.local/node/bin/node

# 留空时自动读取 ~/.codex/config.toml 里的 model / model_provider
# HERMES_MODEL=
# HERMES_PROVIDER=
HERMES_TOOLSETS=browser,terminal
HERMES_MAX_TURNS=90
HERMES_YOLO=1
HERMES_FORCE_NON_STREAMING=1

# bot 自重启脚本（用于 /restartbot）
BOT_RESTART_SCRIPT=/Users/hkk/Documents/feishu_bot_for_codex/scripts/feishu-hermes-self-restart.sh

# 独立状态文件，避免和 openclaw 共用会话上下文
STATE_FILE=/Users/hkk/Documents/feishu_bot_for_codex/.feishu-hermes-bot-state.json

# 可选: 单条飞书消息分片大小
MAX_TEXT_CHARS=1800
