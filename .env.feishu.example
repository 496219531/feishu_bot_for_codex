FEISHU_APP_ID=cli_xxxxx
FEISHU_APP_SECRET=xxxxxxxx

# 也支持用 APP_ID / APP_SECRET 作为别名（两套填一套即可）
# APP_ID=cli_xxxxx
# APP_SECRET=xxxxxxxx

# 可选: 飞书事件订阅里的 Verification Token
FEISHU_VERIFICATION_TOKEN=***

# 官方 SDK 长连接模式：不需要公网回调 / tunnel
FEISHU_CONNECTION_MODE=long

# 可选: 只允许这些 open_id（逗号分隔）
ALLOWED_OPEN_IDS=

# 服务监听端口
PORT=8787

# Codex 工作目录（建议填你项目绝对路径）
WORKSPACE_DIR=/Users/hkk/Documents/factor_strategy_back_test

# 可选: 指定 codex 可执行文件路径
CODEX_BIN=codex
NODE_BIN=/Users/hkk/.local/node/bin/node

# 可选: Codex 启动模式
# full-auto: 追加 --full-auto
# config: 不追加 --full-auto，交给 ~/.codex/config.toml 和 codex 默认行为决定（推荐）
CODEX_EXEC_MODE=config

# 可选: 指定模型；留空时直接使用 ~/.codex/config.toml
# CODEX_MODEL=

# 可选: 指定推理强度（low / medium / high）；留空时直接使用 ~/.codex/config.toml
# CODEX_REASONING_EFFORT=

# 可选: bot 自重启脚本路径
# BOT_RESTART_SCRIPT=/Users/hkk/Documents/feishu_bot_for_codex/scripts/feishu-bot-self-restart.sh

# 可选: 状态文件路径（保存 thread_id 续聊）
STATE_FILE=/Users/hkk/Documents/factor_strategy_back_test/.feishu-codex-bot-state.json

# 可选: 单条飞书消息分片大小
MAX_TEXT_CHARS=1800
